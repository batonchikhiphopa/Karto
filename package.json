{
  "name": "karto",
  "version": "2.0.0",
  "description": "A local-first web app for focused language learning without accounts or cloud lock-in.",
  "author": "batonchikhiphopa",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/batonchikhiphopa/Karto.git"
  },
  "bugs": {
    "url": "https://github.com/batonchikhiphopa/Karto/issues"
  },
  "homepage": "https://github.com/batonchikhiphopa/Karto#readme",
  "keywords": [
    "flashcards",
    "spaced-repetition",
    "web",
    "indexeddb",
    "pwa",
    "local-first",
    "language-learning"
  ],
  "scripts": {
    "start": "vite",
    "dev": "npm run start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && tsx --test \"src/**/*.test.ts\"",
    "build": "vite build",
    "preview": "vite preview",
    "audit": "npm audit --omit=dev",
    "check": "npm run lint && npm test && npm run build && npm run audit"
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
